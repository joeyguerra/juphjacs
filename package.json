{
  "name": "juphjacs",
  "version": "1.0.0",
  "description": "A simple web site builder. Just use plain html, javascript and css; stupid.",
  "main": "index.mjs",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./server": "./server.mjs",
    "./plugins/*": "./plugins/*",
    "./src/*": "./src/*"
  },
  "files": [
    "index.mjs",
    "server.mjs",
    "src/",
    "plugins/"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "dev": "node --env-file=.env --watch server.mjs"
  },
  "keywords": [
    "web",
    "framework",
    "builder",
    "simple",
    "just",
    "html",
    "javascript",
    "css",
    "hotreload",
    "domdiffed"
  ],
  "author": "Joey Guerra",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "debug": "^4.3.7",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "minimatch": "^10.0.3",
    "morphdom": "^2.7.4",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
